ape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;html=1;fontSize=12;align=left;spacingLeft=4;fontColor=#555555;fontSize=11;" vertex="1" parent="c215"><mxGeometry x="284" width="186" height="24" as="geometry"><mxRectangle width="186" height="24" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="c219" value="mengelompokkan" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c220" value="menerbitkan" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c221" value="memiliki" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c42" target="c83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c222" value="tercatat dalam" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c75" target="c133"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c223" value="berisi (CASCADE)" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c104" target="c129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c224" value="melakukan" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c162" target="c116"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c225" value="melayani" style="edgeStyle=entityRelationEdgeStyle;fontSize=12;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c195" target="c120"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c226" value="ERD Fisik — Perpustakaan Cendekia RH (perpus_003)" style="text;html=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c227" value="Keterangan: PK = kunci primer · FK = kunci tamu (→ tabel tujuan) · UQ = UNIQUE · CK = CHECK · AI = AUTO_INCREMENT · NN = NOT NULL · DEF = DEFAULT · 🔒 = data pribadi (PDP)&lt;br&gt;Semua tabel ENGINE=InnoDB, charset mewarisi utf8mb4_unicode_ci dari perpus_003. Aksi ON DELETE bawaan (RESTRICT) kecuali detail_peminjaman → peminjaman (CASCADE).&lt;br&gt;Nilai turunan hari_terlambat, total denda, jumlah transaksi, dan jumlah eksemplar TIDAK disimpan (keputusan P04). denda_detail_peminjaman disimpan (AB-09).&lt;br&gt;Belum dijaga constraint → Modul 14: maks. 6 eksemplar per peminjaman (AB-05), eksemplar harus tersedia &amp;amp; baik saat dipinjam (AB-05), jatuh tempo = tgl_peminjaman + 7 (AB-06), anggota harus aktif (AB-11)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;dashed=1;strokeColor=#999999;fillColor=#fafafa;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="2340" height="130" as="geometry"/></mxCell><mxCell id="c228" value="RIZAL HAFIZ - 25430003 - KELAS A" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1860" y="920" width="500" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>