        <mxCell id="note1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontSize=11;fontColor=#222222;dashed=1;strokeColor=#888888;fillColor=#fafafa;" value="&lt;b&gt;Keterangan&lt;/b&gt;&amp;nbsp; PK = kunci primer &amp;nbsp; FK = kunci tamu &amp;nbsp;&amp;nbsp; &lt;b&gt;Kardinalitas&lt;/b&gt;&amp;nbsp; 1 = tepat satu &amp;nbsp; 0..N = nol atau banyak &amp;nbsp; 1..N = satu atau banyak&lt;br&gt;&lt;b&gt;Denda&lt;/b&gt; tidak dijadikan entitas tersendiri: nilainya dihitung saat pengembalian (PB-05) lalu disimpan pada detail_peminjaman (AB-08, AB-09).&lt;br&gt;&lt;b&gt;Hari terlambat&lt;/b&gt; tidak disimpan, dihitung dari tanggal_pengembalian (atau tanggal pemeriksaan) dikurangi tanggal_jatuh_tempo, minimum 0. Denda = Rp4.000 × hari terlambat per eksemplar.&lt;br&gt;&lt;i&gt;Maksimal 6 eksemplar per transaksi (AB-05) dan lama pinjam 7 hari (AB-06) adalah aturan bisnis, tidak digambarkan pada notasi Crow&#39;s Foot.&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="1440" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=10;fontSize=11;fontColor=#222222;dashed=1;strokeColor=#888888;fillColor=#fafafa;" value="&lt;b&gt;PENELUSURAN KI → JALUR ERD&lt;/b&gt;&lt;br&gt;KI-01 Daftar anggota aktif/nonaktif → anggota&lt;br&gt;KI-02 Judul buku dan jumlah eksemplar tersedia → buku → eksemplar&lt;br&gt;KI-03 Peminjaman yang masih berlangsung → anggota → peminjaman → detail_peminjaman → eksemplar&lt;br&gt;KI-04 Keterlambatan pengembalian → peminjaman → detail_peminjaman&lt;br&gt;KI-05 Rekapitulasi denda per bulan → detail_peminjaman&lt;br&gt;KI-06 Aktivitas peminjaman per bulan → peminjaman → detail_peminjaman&lt;br&gt;KI-07 Eksemplar rusak → eksemplar → buku" vertex="1">
          <mxGeometry height="130" width="1440" x="40" y="670" as="geometry" />
        </mxCell>
